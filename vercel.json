{
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/remind.ts":          { "maxDuration": 15 },
    "api/add.ts":             { "maxDuration": 10 },
    "api/client/[token].ts":  { "maxDuration": 10 },
    "api/weekly-summary.ts":  { "maxDuration": 15 },
    "api/meta-leads.ts":      { "maxDuration": 15 },
    "api/apply.ts":           { "maxDuration": 10 },
    "api/wa-webhook.ts":      { "maxDuration": 15 },
    "api/wa-send.ts":         { "maxDuration": 15 },
    "api/wa-resolve.ts":      { "maxDuration": 15 },
    "api/wa-media.ts":        { "maxDuration": 15 },
    "api/match-candidates.ts": { "maxDuration": 30 },
    "api/wa-note-draft.ts":   { "maxDuration": 20 }
  }
}
