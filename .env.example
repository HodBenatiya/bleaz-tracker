VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# waha | greenapi. If empty: Green API when GREENAPI_ID_INSTANCE is set, otherwise WAHA.
WA_PROVIDER=waha
# Optional. When set, the webhook requires Authorization: Bearer <token>
WA_WEBHOOK_TOKEN=

# WAHA (devlikeapro/waha). Server-side only — never expose the key to the browser.
WAHA_URL=https://waha.example.com
WAHA_API_KEY=
WAHA_SESSION=default
# Business line. Its WhatsApp LID is not a phone and must not become a conversation.
WAHA_OWN_PHONE=0559817733
WAHA_OWN_LID=82077663920366
# Optional. Signs files in the private wa-media bucket. Without it, run schema_wa_media.sql
# so the anon key can upload, and the API falls back to the public cvs bucket.
SUPABASE_SERVICE_ROLE_KEY=

# Existing Green API instance. Still used when WA_PROVIDER=greenapi.
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_API_URL=
# Optional second Green instance for the leads number during the transition.
GREENAPI_INBOX_ID_INSTANCE=
GREENAPI_INBOX_API_TOKEN=
GREENAPI_INBOX_API_URL=
